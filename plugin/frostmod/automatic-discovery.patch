+// MXB Manager: callbacks arrive in small batches, not one complete browser pass.
+// Keep a bounded, expiring address book for this process; never append file history.
+class ObservedRows {
+    struct Entry { Row row; uint64_t at; };
+    std::map<std::string, Entry> entries;
+    uint64_t ttl;
+    size_t limit;
+public:
+    uint64_t lastSeen = 0;
+    explicit ObservedRows(uint64_t ttlMs = 6ULL * 3600 * 1000, size_t maxRows = kMaxRows)
+        : ttl(ttlMs), limit(maxRows) {}
+    void Observe(const uint8_t* raw, size_t len, const char* name, uint64_t now) {
+        std::string address;
+        const std::string clean = CleanName(name);
+        if (!limit || clean.empty() || !DecodeAddress(raw, len, address)) return;
+        if (!entries.count(address) && entries.size() >= limit) {
+            const auto oldest = std::min_element(entries.begin(), entries.end(),
+                [](const auto& a, const auto& b) { return a.second.at < b.second.at; });
+            entries.erase(oldest);
+        }
+        entries[address] = Entry{Row{address, clean}, now};
+        lastSeen = now;
+    }
+    std::vector<Row> Snapshot(uint64_t now) {
+        std::vector<Row> rows;
+        for (auto it = entries.begin(); it != entries.end();) {
+            if (now < it->second.at || now - it->second.at >= ttl) it = entries.erase(it);
+            else { rows.push_back(it->second.row); ++it; }
+        }
+        return rows;
+    }
+};
+
 } // namespace masterlist
 } // namespace frostmod
