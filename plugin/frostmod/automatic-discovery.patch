-    else path.clear();
-    const std::string tmp = path + "frostmod_masterlist.tmp";
-    path += frostmod::masterlist::kFileName;
-    const uint64_t ms = (uint64_t)std::chrono::duration_cast<std::chrono::milliseconds>(
-        std::chrono::system_clock::now().time_since_epoch()).count();
-    const std::string text = frostmod::masterlist::Serialize(g_mlPass, ms);
-    FILE* f = nullptr;
-    if (fopen_s(&f, tmp.c_str(), "wb") != 0 || !f) return;
-    const bool ok = fwrite(text.data(), 1, text.size(), f) == text.size();
-    fclose(f);
-    if (ok && MoveFileExA(tmp.c_str(), path.c_str(), MOVEFILE_REPLACE_EXISTING)) {
-        g_mlLast = g_mlPass;
-        Log("[masterlist] published %zu server(s) for MXB App", g_mlLast.size());
+// MXB Manager patch: capture rows without filesystem work on the game thread.
+static std::mutex g_mlMutex;
+static std::vector<frostmod::masterlist::Row> g_mlPass, g_mlPending;
+static HANDLE g_mlStop = nullptr, g_mlThread = nullptr;
+static std::string g_mlFile;
+static ULONGLONG g_mlSeen = 0;
+
+static DWORD WINAPI MasterListWorker(LPVOID) {
+    std::vector<frostmod::masterlist::Row> last;
+    ULONGLONG written = 0;
+    const std::string tmp = g_mlFile + ".tmp";
+    DeleteFileA(tmp.c_str());
+    DeleteFileA(g_mlFile.c_str());
+    while (WaitForSingleObject(g_mlStop, 500) == WAIT_TIMEOUT) {
+        std::vector<frostmod::masterlist::Row> rows;
+        ULONGLONG seen;
+        {
+            std::lock_guard<std::mutex> lock(g_mlMutex);
+            rows = g_mlPending.empty() ? g_mlPass : g_mlPending;
+            g_mlPending.clear();
+            seen = g_mlSeen;
+        }
+        const auto now = GetTickCount64();
+        if (!seen || now - seen > 2000 || (rows == last && now - written < 60000)) continue;
+        const uint64_t ms = (uint64_t)std::chrono::duration_cast<std::chrono::milliseconds>(
+            std::chrono::system_clock::now().time_since_epoch()).count();
+        const std::string text = frostmod::masterlist::Serialize(rows, ms);
+        FILE* f = nullptr;
+        if (fopen_s(&f, tmp.c_str(), "wb") != 0 || !f) continue;
+        const bool ok = fwrite(text.data(), 1, text.size(), f) == text.size();
+        const bool closed = fclose(f) == 0;
+        if (ok && closed && MoveFileExA(tmp.c_str(), g_mlFile.c_str(), MOVEFILE_REPLACE_EXISTING)) {
+            if (rows != last) Log("[masterlist] published %zu server(s) for MXB Manager", rows.size());
+            last = rows;
+            written = now;
+        } else DeleteFileA(tmp.c_str());
+    }
+    DeleteFileA(tmp.c_str());
+    DeleteFileA(g_mlFile.c_str());
+    return 0;
+}
+static void MasterListStart() {
+    if (g_unloading.load() || g_mlThread || !g_logPath[0]) return;
+    g_mlFile = g_logPath;
+    const size_t sep = g_mlFile.find_last_of("\\/");
+    g_mlFile = (sep == std::string::npos ? std::string() : g_mlFile.substr(0, sep + 1))
+        + frostmod::masterlist::kFileName;
+    g_mlStop = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+    if (g_mlStop) g_mlThread = CreateThread(nullptr, 0, MasterListWorker, nullptr, 0, nullptr);
+    if (!g_mlThread && g_mlStop) { CloseHandle(g_mlStop); g_mlStop = nullptr; }
+}
+static void MasterListStop(bool canBlock) {
+    if (g_mlStop) SetEvent(g_mlStop);
+    if (canBlock && g_mlThread && WaitForSingleObject(g_mlThread, 2000) == WAIT_OBJECT_0) {
+        CloseHandle(g_mlThread); g_mlThread = nullptr;
+        CloseHandle(g_mlStop); g_mlStop = nullptr;
     }
 }
 
